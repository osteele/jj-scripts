#!/bin/bash
set -euo pipefail

# Source shared library
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/jj-ai-lib.sh"

# Check for llm installation
if ! command -v llm >/dev/null 2>&1; then
    echo "Error: llm command not found. Install from https://llm.datasette.io/en/stable/setup.html" >&2
    exit 1
fi

# Check for jj installation
if ! command -v jj >/dev/null 2>&1; then
    echo "Error: jj command not found. Install from https://github.com/martinvonz/jj" >&2
    exit 1
fi

usage() {
    cat << EOF
Usage: $(basename "$0") [options] [REVSETS]...

Generate conventional commit messages for Jujutsu revisions using AI.
Each revset is expanded to individual revisions, and a unique message
is generated for each revision based on its changes.

By default, only revisions with empty descriptions are processed.
Use --replace to process all revisions regardless of their current description.

If no revsets are specified, uses the current working copy (@).

Options:
    -m, --model MODEL       Specify the LLM model to use (default: auto-select)
                            Examples: gpt-4, claude-3-opus, mistral-7b, ...
    -n, --dry-run           Show the messages without applying them
    -p, --prompt PROMPT     Provide additional instructions for the message
    --replace               Process all revisions, replacing existing descriptions
    -l, --list              List available models

    Diff options (passed to jj diff):
    -f, --from REVSET       Starting revset for diff
    -t, --to REVSET         Ending revset for diff
    -r, --revisions REVSET  Revisions to diff (alternative to --from/--to)

    Description options:
    --edit                  Open editor after generating the message
    --no-edit               Don't open editor (default)
    --reset-author          Reset the author to the configured user
    --author AUTHOR         Set a specific author for the revision

    -h, --help              Show this help

Examples:
    $(basename "$0")                    # Describe @ (if empty)
    $(basename "$0") abc123             # Describe single revision (if empty)
    $(basename "$0") @- @               # Describe two revisions (only if empty)
    $(basename "$0") "main..@"          # Describe revisions from main to @ (only empty ones)
    $(basename "$0") --replace "main..@" # Replace all descriptions, even non-empty
    $(basename "$0") -n @ "fork..@-"    # Dry-run for @ and fork..@- range (only empty)
    $(basename "$0") @ --from main      # Describe @ using diff from main (if empty)
EOF
    exit 1
}

# Default values
model=$(select_default_model)
dry_run=false
custom_prompt=""
replace_mode=false

# Arrays for jj arguments and revsets
declare -a jj_describe_args=()
declare -a jj_diff_args=()
declare -a revset_args=()

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -m|--model)
            if [[ $# -lt 2 ]] || [[ "$2" == -* ]]; then
                echo "Error: --model requires an argument" >&2
                exit 1
            fi
            model="$2"
            shift 2
            ;;
        -n|--dry-run)
            dry_run=true
            shift
            ;;
        -l|--list)
            echo "Available models:"
            llm models
            exit 0
            ;;
        -p|--prompt)
            if [[ $# -lt 2 ]] || [[ "$2" == -* ]]; then
                echo "Error: --prompt requires an argument" >&2
                exit 1
            fi
            custom_prompt="$2"
            shift 2
            ;;
        --replace)
            replace_mode=true
            shift
            ;;
        -f|--from)
            if [[ $# -lt 2 ]] || [[ "$2" == -* ]]; then
                echo "Error: --from requires an argument" >&2
                exit 1
            fi
            jj_diff_args+=("--from" "$2")
            shift 2
            ;;
        -t|--to)
            if [[ $# -lt 2 ]] || [[ "$2" == -* ]]; then
                echo "Error: --to requires an argument" >&2
                exit 1
            fi
            jj_diff_args+=("--to" "$2")
            shift 2
            ;;
        -r|--revisions)
            if [[ $# -lt 2 ]] || [[ "$2" == -* ]]; then
                echo "Error: --revisions requires an argument" >&2
                exit 1
            fi
            jj_diff_args+=("--revisions" "$2")
            shift 2
            ;;
        --edit)
            jj_describe_args+=("--edit")
            shift
            ;;
        --no-edit)
            jj_describe_args+=("--no-edit")
            shift
            ;;
        --reset-author)
            jj_describe_args+=("--reset-author")
            shift
            ;;
        --author)
            if [[ $# -lt 2 ]] || [[ "$2" == -* ]]; then
                echo "Error: --author requires an argument" >&2
                exit 1
            fi
            jj_describe_args+=("--author" "$2")
            shift 2
            ;;
        -h|--help)
            usage
            ;;
        *)
            if [[ $1 == -* ]]; then
                echo "Error: Unknown option: $1" >&2
                usage
            else
                revset_args+=("$1")
                shift
            fi
            ;;
    esac
done

# Default to @ if no revsets specified
if [ ${#revset_args[@]} -eq 0 ]; then
    revset_args=("@")
fi

# Check if we're in a jj repository
if ! jj root >/dev/null 2>&1; then
    echo "Error: Not in a Jujutsu repository" >&2
    exit 1
fi

# Expand revsets to individual revisions
# Combine all revset args with | (union) and get individual revisions in topological order
all_revsets=$(IFS='|'; echo "${revset_args[*]}")
revisions=()
while IFS= read -r line; do
    [ -n "$line" ] && revisions+=("$line")
done < <(jj log --no-graph --no-pager -r "$all_revsets" -T 'change_id.short() ++ "\n"')

# Check that we got at least one revision
if [ ${#revisions[@]} -eq 0 ]; then
    echo "Error: No revisions matched the provided revsets" >&2
    exit 1
fi

# Filter to only empty descriptions unless --replace is specified
if [ "$replace_mode" = false ]; then
    # First, validate that each revset has at least one empty description
    for revset_arg in "${revset_args[@]}"; do
        empty_count=$(jj log --no-graph --no-pager -r "$revset_arg" -T 'if(description, "", change_id.short() ++ "\n")' | grep -c '^' || true)
        if [ "$empty_count" -eq 0 ]; then
            echo "Error: Revset '$revset_arg' contains no revisions with empty descriptions" >&2
            echo "Use --replace to process revisions with existing descriptions" >&2
            exit 1
        fi
    done

    # Filter revisions to only those with empty descriptions
    filtered_revisions=()
    for revision in "${revisions[@]}"; do
        has_desc=$(jj log --no-pager --no-graph -r "$revision" -T 'if(description, "yes", "")')
        if [ -z "$has_desc" ]; then
            filtered_revisions+=("$revision")
        fi
    done

    # Update revisions array
    revisions=("${filtered_revisions[@]}")

    # Check if we have any revisions left after filtering
    if [ ${#revisions[@]} -eq 0 ]; then
        echo "No revisions with empty descriptions found" >&2
        exit 0
    fi

    echo "Processing ${#revisions[@]} revision(s) with empty descriptions"
fi

# Load additional instructions from config files (once for all revisions)
repo_root=$(jj root)
additional_instructions=$(load_additional_instructions "$repo_root")

# Combine additional instructions with custom prompt (once for all revisions)
combined_prompt="$additional_instructions"
if [ -n "$custom_prompt" ]; then
    if [ -n "$combined_prompt" ]; then
        combined_prompt="$combined_prompt

"
    fi
    combined_prompt="$combined_prompt$custom_prompt"
fi

model_display=$(resolve_model_display "$model")

# Process revisions based on mode (dry-run vs apply)
if [ "$dry_run" = true ]; then
    # Dry-run mode: generate all messages first, then display all
    declare -a generated_messages=()

    for revision in "${revisions[@]}"; do
        # Get the current description
        current_desc=$(jj log --no-pager --no-graph -r "$revision" -T 'description')

        # Generate message with progress indicator
        echo -n "Generating message for $revision... " >&2

        # Get the diff and pipe it through the message generator
        if [ ${#jj_diff_args[@]} -gt 0 ]; then
            # Use the custom diff arguments
            commit_msg=$(jj diff --no-pager "${jj_diff_args[@]}" --git | generate_commit_message "$model" "$combined_prompt" "$current_desc")
        else
            # Default: use the revision's own changes
            commit_msg=$(jj diff --no-pager -r "$revision" --git | generate_commit_message "$model" "$combined_prompt" "$current_desc")
        fi

        # Check if generation succeeded
        if [ $? -ne 0 ]; then
            printf "\r\033[K" >&2
            echo "Error: Failed to generate message for revision $revision" >&2
            exit 1
        fi

        printf "\r\033[K" >&2  # Clear progress message

        # Store the generated message
        generated_messages+=("$commit_msg")
    done

    # Display all generated messages
    for i in "${!revisions[@]}"; do
        revision="${revisions[$i]}"
        commit_msg="${generated_messages[$i]}"

        echo -e "\n=========================================="
        echo "== Revision $revision =="

        # Get and show current description
        current_desc=$(jj log --no-pager --no-graph -r "$revision" -T 'description')
        if [ -n "$current_desc" ]; then
            first_line=$(echo "$current_desc" | head -n 1)
            echo "Previous description: $first_line"
            echo
        fi

        # Show list of changed files
        jj diff --no-pager --summary -r "$revision"

        echo -e "\n== Generated Description (via ${model_display}) =="
        echo "$commit_msg"
    done

    echo -e "\n=========================================="
    echo "Dry-run complete. No descriptions were applied."
    echo "Processed ${#revisions[@]} revision(s)."
else
    # Apply mode: generate and apply each revision sequentially
    for revision in "${revisions[@]}"; do
        echo -e "\n=========================================="
        echo "== Processing revision $revision =="

        # Get the current description
        current_desc=$(jj log --no-pager --no-graph -r "$revision" -T 'description')

        # Show first line of previous description if it exists
        if [ -n "$current_desc" ]; then
            first_line=$(echo "$current_desc" | head -n 1)
            echo "Previous description: $first_line"
            echo
        fi

        # Show list of changed files
        jj diff --no-pager --summary -r "$revision"

        # If using diff args, show what we're diffing
        if [ ${#jj_diff_args[@]} -gt 0 ]; then
            echo -e "\n== Using custom diff parameters =="
        fi

        # Generate message with progress indicator
        echo -e "\n== Generating Description (via ${model_display}) =="
        echo -n "Generating commit message... " >&2

        # Get the diff and pipe it through the message generator
        if [ ${#jj_diff_args[@]} -gt 0 ]; then
            # Use the custom diff arguments
            commit_msg=$(jj diff --no-pager "${jj_diff_args[@]}" --git | generate_commit_message "$model" "$combined_prompt" "$current_desc")
        else
            # Default: use the revision's own changes
            commit_msg=$(jj diff --no-pager -r "$revision" --git | generate_commit_message "$model" "$combined_prompt" "$current_desc")
        fi

        # Check if generation succeeded
        if [ $? -ne 0 ]; then
            printf "\r\033[K" >&2
            echo "Error: Failed to generate message for revision $revision" >&2
            exit 1
        fi

        printf "\r\033[K" >&2  # Clear progress message

        # Display the message
        echo "$commit_msg"

        # Apply the new description to the revision
        echo -e "\n== Applying new description ==" >&2
        if [ ${#jj_describe_args[@]} -gt 0 ]; then
            jj describe -r "$revision" -m "$commit_msg" "${jj_describe_args[@]}"
        else
            jj describe -r "$revision" -m "$commit_msg"
        fi

        # Check if application succeeded
        if [ $? -ne 0 ]; then
            echo "Error: Failed to apply description for revision $revision" >&2
            exit 1
        fi

        echo "✓ Description applied successfully"
    done

    echo -e "\n=========================================="
    echo "Successfully processed ${#revisions[@]} revision(s)."
fi
