#!/bin/bash
set -euo pipefail

# Check for llm installation
if ! command -v llm >/dev/null 2>&1; then
    echo "Error: llm command not found. Install from https://llm.datasette.io/en/stable/setup.html" >&2
    exit 1
fi

# Check for jj installation
if ! command -v jj >/dev/null 2>&1; then
    echo "Error: jj command not found. Install from https://github.com/martinvonz/jj" >&2
    exit 1
fi

usage() {
    cat << EOF
Usage: $(basename "$0") [options] [FILESETS]...

Create a new change with an AI-generated commit message, similar to 'jj commit'.
The AI analyzes the changes and creates a conventional commit message.

Arguments:
    [FILESETS]          Files to include in the commit (default: all changes)

Options:
    -m, --model MODEL   Specify the LLM model to use (default: auto-select)
                        Examples: gpt-4, claude-3-opus, gemini-2.5-flash-lite
    -n, --dry-run       Show the message without creating the commit
    -p, --prompt PROMPT Provide additional instructions for the message
    -l, --list          List available models
    -i, --interactive   Interactively choose which changes to include
    --tool NAME         Specify diff editor to use (implies --interactive)
    --edit              Open editor after generating the message
    --no-edit           Don't open editor (default)
    --reset-author      Reset the author to the configured user
    --author AUTHOR     Set a specific author for the revision
    -h, --help          Show this help

Examples:
    $(basename "$0")                               # Commit all changes
    $(basename "$0") src/                          # Commit changes in src/
    $(basename "$0") README.md lib/*.py            # Commit specific files
    $(basename "$0") -m gemini-2.5-flash-lite      # Use specific model
    $(basename "$0") -i                            # Interactive selection

To set a default model, use:
    llm aliases set ai-commit-message <model-name>
    
For example:
    llm aliases set ai-commit-message openrouter/google/gemini-2.5-flash-lite
EOF
    exit 1
}

# Default model selection
select_default_model() {
    local models
    models=$(llm models)

    # Check if we got any models
    if [ -z "$models" ]; then
        echo "Error: No LLM models found. Please install at least one model." >&2
        exit 1
    fi

    # Define preferred models in order of preference
    local preferred_models=(
        "ai-commit-message"
        "claude-3.5-sonnet"
        "gemini-2.0-flash-latest"
        "o3-mini"
        "deepseek-coder"
        "gpt-4o-mini"
    )

    # Try each preferred model in order
    for model in "${preferred_models[@]}"; do
        if echo "$models" | grep -q "$model"; then
            echo "$model"
            return 0
        fi
    done

    # If no preferred model is found, use the first available model
    echo "$models" | head -n 1
}

# Default values
model=$(select_default_model)
dry_run=false
custom_prompt=""

# Arrays for organizing arguments
declare -a filesets=()
declare -a jj_commit_args=()

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -m|--model)
            model="$2"
            shift 2
            ;;
        -n|--dry-run)
            dry_run=true
            shift
            ;;
        -l|--list)
            echo "Available models:"
            llm models
            exit 0
            ;;
        -p|--prompt)
            custom_prompt="$2"
            shift 2
            ;;
        -i|--interactive)
            jj_commit_args+=("--interactive")
            shift
            ;;
        --tool)
            jj_commit_args+=("--tool" "$2")
            shift 2
            ;;
        --edit)
            jj_commit_args+=("--edit")
            shift
            ;;
        --no-edit)
            jj_commit_args+=("--no-edit")
            shift
            ;;
        --reset-author)
            jj_commit_args+=("--reset-author")
            shift
            ;;
        --author)
            jj_commit_args+=("--author" "$2")
            shift 2
            ;;
        -h|--help)
            usage
            ;;
        -*)
            echo "Error: Unknown option: $1" >&2
            usage
            ;;
        *)
            # Positional argument (fileset)
            filesets+=("$1")
            shift
            ;;
    esac
done

# Check if we're in a jj repository
if ! jj root >/dev/null 2>&1; then
    echo "Error: Not in a Jujutsu repository" >&2
    exit 1
fi

# Get the diff for the specified files (or all changes if no files specified)
echo -e "\n== Changes to commit =="
if [ ${#filesets[@]} -gt 0 ]; then
    echo "Files: ${filesets[*]}"
    diff_content=$(jj diff --no-pager --git "${filesets[@]}")
else
    echo "All changes in working copy"
    diff_content=$(jj diff --no-pager --git)
fi

# Check if there are any changes
if [ -z "$diff_content" ]; then
    echo "No changes to commit" >&2
    exit 0
fi

# Show a summary of changes
if [ ${#filesets[@]} -gt 0 ]; then
    jj diff --no-pager --summary "${filesets[@]}"
else
    jj diff --no-pager --summary
fi

# Generate commit message with progress indicator
# Check if the model is an alias and resolve it
model_display="$model"
if [[ "$model" == "ai-commit-message" ]]; then
    resolved_model=$(llm aliases list 2>/dev/null | grep "^ai-commit-message" | sed 's/^ai-commit-message[[:space:]]*:[[:space:]]*//')
    if [[ -n "$resolved_model" ]]; then
        model_display="ai-commit-message: $resolved_model"
    fi
fi

echo -e "\n== Generating Commit Message (via ${model_display}) =="
echo -n "Generating commit message... " >&2

# Build the prompt
if [[ -n "$custom_prompt" ]]; then
    prompt_text="Analyze these changes and create a commit message according to the following instructions:

Changes:
\`\`\`
$diff_content
\`\`\`

Instructions:
\`\`\`
$custom_prompt
\`\`\`

Format the response as a conventional commit message with a brief title line followed by a more detailed description if needed.
Don't include any other text in the response, just the commit message."
else
    prompt_text="Analyze these changes and create a conventional commit message:

\`\`\`
$diff_content
\`\`\`

Format the response as a conventional commit message with a brief title line followed by a more detailed description if needed.
Follow the conventional commit format (e.g., feat:, fix:, docs:, chore:, refactor:, test:, style:).
Don't include any other text in the response, just the commit message."
fi

commit_msg=$(llm \
    --model "$model" \
    "$prompt_text"
)

printf "\r\033[K" >&2  # Clear progress message

# Strip markdown code fences if present
if [[ "$commit_msg" =~ ^\`\`\`.* ]] && [[ "$commit_msg" =~ \`\`\`$ ]]; then
    commit_msg=$(echo "$commit_msg" | sed -e '1s/^```.*//' -e '$s/```$//' | sed '/^$/d')
fi

# Display the message
echo "$commit_msg"

if [ "$dry_run" = true ]; then
    echo -e "\n== Next Steps =="
    if [ ${#filesets[@]} -gt 0 ]; then
        echo "To commit these files with this message, run:"
        echo "  jj commit ${filesets[*]} -m \"...\""
    else
        echo "To commit all changes with this message, run:"
        echo "  jj commit -m \"...\""
    fi
else
    echo -e "\n== Creating commit ==" >&2
    
    # Create the commit with the generated message
    # Build command with proper array handling
    commit_cmd=(jj commit -m "$commit_msg")
    
    # Add filesets if any
    if [ ${#filesets[@]} -gt 0 ]; then
        commit_cmd+=("${filesets[@]}")
    fi
    
    # Add additional jj commit arguments if any
    if [ ${#jj_commit_args[@]} -gt 0 ]; then
        commit_cmd+=("${jj_commit_args[@]}")
    fi
    
    # Execute the commit
    if "${commit_cmd[@]}"; then
        echo "Commit created successfully!"
        
        # Show the new commit
        echo -e "\n== New commit =="
        jj log --no-pager -r @- -n 1
    else
        echo "Error: Failed to create commit" >&2
        exit 1
    fi
fi