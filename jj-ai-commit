#!/bin/bash
set -eo pipefail

# Source shared library
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/jj-ai-lib.sh"

# Check for llm installation
if ! command -v llm >/dev/null 2>&1; then
    echo "Error: llm command not found. Install from https://llm.datasette.io/en/stable/setup.html" >&2
    exit 1
fi

# Check for jj installation
if ! command -v jj >/dev/null 2>&1; then
    echo "Error: jj command not found. Install from https://github.com/martinvonz/jj" >&2
    exit 1
fi

usage() {
    cat << EOF
Usage: $(basename "$0") [options] [FILESETS]...

Create a new change with an AI-generated commit message, similar to 'jj commit'.
The AI analyzes the changes and creates a conventional commit message.

Arguments:
    [FILESETS]          Files to include in the commit (default: all changes)

Options:
    -m, --model MODEL   Specify the LLM model to use (default: auto-select)
                        Examples: gpt-4, claude-3-opus, gemini-2.5-flash-lite
    -n, --dry-run       Show the message without creating the commit
    -p, --prompt PROMPT Provide additional instructions for the message
    --narrate-diff WHEN Control diff narration: auto, always, or never
                          (default: never)
    -l, --list          List available models
    -i, --interactive   Interactively choose which changes to include
    --tool NAME         Specify diff editor to use (implies --interactive)
    --edit              Open editor after generating the message
    --no-edit           Don't open editor (default)
    --reset-author      Reset the author to the configured user
    --author AUTHOR     Set a specific author for the revision

    Global jj options (passed to all jj commands):
    --ignore-immutable  Allow rewriting immutable revisions
    --debug             Enable debug output (shows prompts and LLM calls)
    --color WHEN        Colorize output (always, never, auto)
    --quiet             Suppress non-error output
    --no-pager          Disable pager
    --config NAME=VALUE Set a config option (can be repeated)
    --config-file PATH  Additional config file to read

    -h, --help          Show this help

Examples:
    $(basename "$0")                               # Commit all changes
    $(basename "$0") src/                          # Commit changes in src/
    $(basename "$0") README.md lib/*.py            # Commit specific files
    $(basename "$0") -m gemini-2.5-flash-lite      # Use specific model
    $(basename "$0") -i                            # Interactive selection

To set a default model, use:
    llm aliases set ai-commit-message <model-name>
    
For example:
    llm aliases set ai-commit-message openrouter/google/gemini-2.5-flash-lite
EOF
    exit 1
}

# Default values
model=$(select_default_model)
dry_run=false
custom_prompt=""
AI_COMMIT_NARRATE_DIFF="${AI_COMMIT_NARRATE_DIFF:-never}"
export AI_COMMIT_NARRATE_DIFF
DEBUG=false
QUIET=false

# Arrays for organizing arguments
declare -a jj_global_args=()
declare -a filesets=()
declare -a jj_commit_args=()

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -m|--model)
            if [[ $# -lt 2 ]]; then
                echo "Error: --model requires an argument" >&2
                exit 1
            fi
            model="$2"
            shift 2
            ;;
        -n|--dry-run)
            dry_run=true
            shift
            ;;
        -l|--list)
            echo "Available models:"
            llm models
            exit 0
            ;;
        -p|--prompt)
            if [[ $# -lt 2 ]]; then
                echo "Error: --prompt requires an argument" >&2
                exit 1
            fi
            custom_prompt="$2"
            shift 2
            ;;
        --narrate-diff)
            if [[ $# -lt 2 ]]; then
                echo "Error: --narrate-diff requires an argument" >&2
                exit 1
            fi
            validate_narration_policy "$2"
            AI_COMMIT_NARRATE_DIFF="$2"
            export AI_COMMIT_NARRATE_DIFF
            shift 2
            ;;
        -i|--interactive)
            jj_commit_args+=("--interactive")
            shift
            ;;
        --tool)
            jj_commit_args+=("--tool" "$2")
            shift 2
            ;;
        --edit)
            jj_commit_args+=("--edit")
            shift
            ;;
        --no-edit)
            jj_commit_args+=("--no-edit")
            shift
            ;;
        --reset-author)
            jj_commit_args+=("--reset-author")
            shift
            ;;
        --author)
            jj_commit_args+=("--author" "$2")
            shift 2
            ;;
        --ignore-immutable)
            jj_global_args+=("--ignore-immutable")
            shift
            ;;
        --debug)
            jj_global_args+=("--debug")
            DEBUG=true
            shift
            ;;
        --color)
            if [[ $# -lt 2 ]]; then
                echo "Error: --color requires an argument" >&2
                exit 1
            fi
            jj_global_args+=("--color" "$2")
            shift 2
            ;;
        --quiet)
            jj_global_args+=("--quiet")
            QUIET=true
            shift
            ;;
        --no-pager)
            jj_global_args+=("--no-pager")
            shift
            ;;
        --config)
            if [[ $# -lt 2 ]]; then
                echo "Error: --config requires an argument" >&2
                exit 1
            fi
            jj_global_args+=("--config" "$2")
            shift 2
            ;;
        --config-file)
            if [[ $# -lt 2 ]]; then
                echo "Error: --config-file requires an argument" >&2
                exit 1
            fi
            jj_global_args+=("--config-file" "$2")
            shift 2
            ;;
        -h|--help)
            usage
            ;;
        -*)
            echo "Error: Unknown option: $1" >&2
            usage
            ;;
        *)
            # Positional argument (fileset)
            filesets+=("$1")
            shift
            ;;
    esac
done

# Check if we're in a jj repository
if ! jj "${jj_global_args[@]}" root >/dev/null 2>&1; then
    echo "Error: Not in a Jujutsu repository" >&2
    exit 1
fi

# Check if there are any changes and show a summary
if [ "$QUIET" = false ]; then
    echo -e "\n== Changes to commit =="
fi
if [ ${#filesets[@]} -gt 0 ]; then
    if [ "$QUIET" = false ]; then
        echo "Files: ${filesets[*]}"
    fi
    # Check if there are any changes in the specified files
    # Note: Use variable instead of pipe to avoid pipefail interaction with jj exit code
    diff_check=$(jj "${jj_global_args[@]}" diff --no-pager --summary "${filesets[@]}" 2>/dev/null || true)
    if [ -z "$diff_check" ]; then
        echo "No changes to commit in specified files" >&2
        exit 0
    fi
else
    if [ "$QUIET" = false ]; then
        echo "All changes in working copy"
    fi
    # Check if there are any changes in the working copy revision
    # Use -r @ to check changes IN the revision, not uncommitted filesystem changes
    # Note: Use variable instead of pipe to avoid pipefail interaction with jj exit code
    diff_check=$(jj "${jj_global_args[@]}" diff --no-pager --stat -r @ 2>/dev/null || true)
    if [ -z "$diff_check" ]; then
        echo "No changes to commit" >&2
        exit 0
    fi
fi

# Load additional instructions from config files
repo_root=$(jj "${jj_global_args[@]}" root)
additional_instructions=$(load_additional_instructions "$repo_root")

if [ "$DEBUG" = true ]; then
    echo "[DEBUG] Loaded instruction files:" >&2
    if [ -n "$additional_instructions" ]; then
        echo "$additional_instructions" | head -n 3 >&2
        echo "..." >&2
    else
        echo "[DEBUG] No additional instructions found" >&2
    fi
fi

# Combine additional instructions with custom prompt
combined_prompt="$additional_instructions"
if [ -n "$custom_prompt" ]; then
    if [ -n "$combined_prompt" ]; then
        combined_prompt="$combined_prompt

"
    fi
    combined_prompt="$combined_prompt$custom_prompt"
fi

# Generate commit message with progress indicator
model_display=$(resolve_model_display "$model")

if [ "$DEBUG" = true ]; then
    echo "[DEBUG] Using model: $model_display" >&2
fi

if [ "$QUIET" = false ]; then
    echo -e "\n== Generating Commit Message (via ${model_display}) =="
fi
echo -n "Generating commit message... " >&2

# Get the diff and pipe it through the message generator
# Note: jj-ai-commit doesn't have a current_desc, so pass empty string
if [ ${#filesets[@]} -gt 0 ]; then
    diff_output=$(jj "${jj_global_args[@]}" diff --no-pager --git "${filesets[@]}")
else
    diff_output=$(jj "${jj_global_args[@]}" diff --no-pager --git -r @)
fi

if [ "$DEBUG" = true ]; then
    echo "[DEBUG] Prompt:" >&2
    echo "=== Diff ===" >&2
    echo "$diff_output" | head -n 10 >&2
    echo "..." >&2
    echo "=== Instructions ===" >&2
    echo "$combined_prompt" >&2
fi

commit_msg=$(echo "$diff_output" | generate_commit_message "$model" "$combined_prompt" "" "$AI_COMMIT_NARRATE_DIFF") || {
    printf "\r\033[K" >&2
    echo "Error: Failed to generate commit message" >&2
    exit 1
}

printf "\r\033[K" >&2  # Clear progress message

# Display the message
if [ "$QUIET" = false ]; then
    echo "$commit_msg"
fi

if [ "$dry_run" = true ]; then
    if [ "$QUIET" = false ]; then
        echo -e "\n== Next Steps =="
        if [ ${#filesets[@]} -gt 0 ]; then
            echo "To commit these files with this message, run:"
            echo "  jj commit ${filesets[*]} -m \"...\""
        else
            echo "To commit all changes with this message, run:"
            echo "  jj commit -m \"...\""
        fi
    fi
else
    if [ "$QUIET" = false ]; then
        echo -e "\n== Creating commit ==" >&2
    fi

    # Create the commit with the generated message
    # Build command with proper array handling
    commit_cmd=(jj "${jj_global_args[@]}" commit -m "$commit_msg")

    # Add filesets if any
    if [ ${#filesets[@]} -gt 0 ]; then
        commit_cmd+=("${filesets[@]}")
    fi

    # Add additional jj commit arguments if any
    if [ ${#jj_commit_args[@]} -gt 0 ]; then
        commit_cmd+=("${jj_commit_args[@]}")
    fi

    # Execute the commit
    if "${commit_cmd[@]}"; then
        if [ "$QUIET" = false ]; then
            echo "Commit created successfully!"

            # Show the new commit
            echo -e "\n== New commit =="
            jj "${jj_global_args[@]}" log --no-pager -r @- -n 1
        fi
    else
        echo "Error: Failed to create commit" >&2
        exit 1
    fi
fi
