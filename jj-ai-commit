#!/bin/bash
set -eo pipefail

# Source shared library
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/jj-ai-lib.sh"

# Check for llm installation
if ! command -v llm >/dev/null 2>&1; then
    echo "Error: llm command not found. Install from https://llm.datasette.io/en/stable/setup.html" >&2
    exit 1
fi

# Check for jj installation
if ! command -v jj >/dev/null 2>&1; then
    echo "Error: jj command not found. Install from https://github.com/martinvonz/jj" >&2
    exit 1
fi

usage() {
    cat << EOF
Usage: $(basename "$0") [options] [FILESETS]...

Create a new change with an AI-generated commit message, similar to 'jj commit'.
The AI analyzes the changes and creates a conventional commit message.

Arguments:
    [FILESETS]          Files to include in the commit (default: all changes)

Options:
    -m, --model MODEL   Specify the LLM model to use (default: auto-select)
                        Examples: gpt-4, claude-3-opus, gemini-2.5-flash-lite
    --split             Group changed files into one or several commits by theme
    -n, --dry-run       Show the message or split plan without creating commits
    --print-message     Print only the generated message or plan to stdout and
                        exit (implies --no-decoration; nothing is committed)
    -p, --prompt PROMPT Provide additional instructions for the message
    --no-decoration     Suppress this script's headings; print only results
    --narrate-diff WHEN Control diff narration: auto, always, or never
                          (default: never)
    -l, --list          List available models
    -i, --interactive   Interactively choose which changes to include
    --tool NAME         Specify diff editor to use (implies --interactive)
    --edit              Open editor after generating the message
    --no-edit           Don't open editor (default)
    --reset-author      Reset the author to the configured user
    --author AUTHOR     Set a specific author for the revision

    Global jj options (passed to all jj commands):
    --ignore-immutable  Allow rewriting immutable revisions
    --debug             Enable debug output (shows prompts and LLM calls)
    --color WHEN        Colorize output (always, never, auto)
    --quiet             Suppress non-error output
    --no-pager          Disable pager
    --config NAME=VALUE Set a config option (can be repeated)
    --config-file PATH  Additional config file to read

    -h, --help          Show this help

Examples:
    $(basename "$0")                               # Commit all changes
    $(basename "$0") src/                          # Commit changes in src/
    $(basename "$0") README.md lib/*.py            # Commit specific files
    $(basename "$0") -m gemini-2.5-flash-lite      # Use specific model
    $(basename "$0") -i                            # Interactive selection
    $(basename "$0") --split                       # Group changes into themed commits
    $(basename "$0") --split -n                    # Preview themed commit plan

To set a default model, use:
    llm aliases set ai-commit-message <model-name>
    
For example:
    llm aliases set ai-commit-message openrouter/google/gemini-2.5-flash-lite
EOF
    exit 1
}

# Parse `jj diff --summary` output on stdin.
# Emits one path per line. Deletions are included because they still need
# committing. Renames and copies are rejected: their summary line names two
# paths that must reach exactly one commit, and we cannot guarantee the
# grouping engine keeps them together.
parse_diff_summary() {
    local line
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        local status="${line:0:1}"
        local rest="${line:2}"
        case "$status" in
            A|M|D)
                printf '%s\n' "$rest"
                ;;
            R|C)
                echo "Error: --split does not support renames or copies: $line" >&2
                return 1
                ;;
            *)
                # Defensive: any remaining arrow syntax looks like a rename/copy.
                if [[ "$rest" == *\ =\>* ]]; then
                    echo "Error: --split does not support renames or copies: $line" >&2
                    return 1
                fi
                printf '%s\n' "$rest"
                ;;
        esac
    done
}

# Print a split plan in human-readable form.
print_split_plan() {
    local plan_json="$1"
    local num_commits
    num_commits=$(printf '%s' "$plan_json" | jq '.commits | length')
    if [ "$decorate" = true ]; then
        echo -e "\n== Split plan =="
    fi
    local i
    for (( i=0; i<num_commits; i++ )); do
        local msg
        msg=$(printf '%s' "$plan_json" | jq -r --argjson idx "$i" '.commits[$idx].message')
        if [ "$decorate" = true ]; then
            echo ""
            echo "Commit $((i+1)):"
        fi
        echo "$msg"
        if [ "$decorate" = true ]; then
            echo "Files:"
        fi
        printf '%s' "$plan_json" | jq -r --argjson idx "$i" '.commits[$idx].files[]' | sed 's/^/  /'
    done
}

# Apply a split plan by committing each group in order.
# If a commit fails, report which commits were created and which were not.
apply_split_plan() {
    local plan_json="$1"
    local num_commits
    num_commits=$(printf '%s' "$plan_json" | jq '.commits | length')
    local created_messages=()
    local i
    for (( i=0; i<num_commits; i++ )); do
        local msg
        msg=$(printf '%s' "$plan_json" | jq -r --argjson idx "$i" '.commits[$idx].message')
        local -a commit_files=()
        while IFS= read -r f; do
            commit_files+=("$f")
        done < <(printf '%s' "$plan_json" | jq -r --argjson idx "$i" '.commits[$idx].files[]')

        if [ "$decorate" = true ]; then
            echo -e "\n== Creating commit $((i+1)) of ${num_commits} ==" >&2
        fi

        local commit_cmd=(jj "${jj_global_args[@]}" commit -m "$msg" "${commit_files[@]}")
        if ! "${commit_cmd[@]}"; then
            echo "Error: Failed to create commit $((i+1)) of ${num_commits}" >&2
            if [ ${#created_messages[@]} -gt 0 ]; then
                echo "Created commits:" >&2
                local j
                for (( j=0; j<${#created_messages[@]}; j++ )); do
                    echo "  $((j+1)). ${created_messages[$j]}" >&2
                done
            else
                echo "No commits were created" >&2
            fi
            echo "Not created:" >&2
            local j
            for (( j=i; j<num_commits; j++ )); do
                local not_msg
                not_msg=$(printf '%s' "$plan_json" | jq -r --argjson idx "$j" '.commits[$idx].message')
                echo "  $((j+1)). $not_msg" >&2
            done
            return 1
        fi
        created_messages+=("$msg")
    done

    if [ "$decorate" = true ]; then
        echo -e "\n== Created ${num_commits} commits ==" >&2
        jj "${jj_global_args[@]}" log --no-pager -r "ancestors(@-, ${num_commits})"
    fi
}

# Generate a split plan and either display it or apply it.
run_split_commit() {
    local summary_output
    if [ ${#filesets[@]} -gt 0 ]; then
        summary_output=$(jj "${jj_global_args[@]}" diff --no-pager --summary "${filesets[@]}")
    else
        summary_output=$(jj "${jj_global_args[@]}" diff --no-pager --summary -r @)
    fi

    if [ -z "$summary_output" ]; then
        echo "Error: No changes to split" >&2
        return 1
    fi

    local files_list_text
    files_list_text=$(printf '%s\n' "$summary_output" | parse_diff_summary) || return 1

    if [ -z "$files_list_text" ]; then
        echo "Error: No files to split after parsing diff summary" >&2
        return 1
    fi

    local files_from
    files_from=$(mktemp)
    printf '%s\n' "$files_list_text" > "$files_from"

    local model_display
    model_display=$(resolve_model_display "$model")

    if [ "$decorate" = true ]; then
        echo -e "\n== Generating Split Plan (via ${model_display}) =="
    fi
    echo -n "Generating split plan... " >&2

    local diff_output
    if [ ${#filesets[@]} -gt 0 ]; then
        diff_output=$(jj "${jj_global_args[@]}" diff --no-pager --git "${filesets[@]}")
    else
        diff_output=$(jj "${jj_global_args[@]}" diff --no-pager --git -r @)
    fi

    local plan_json
    if ! plan_json=$(printf '%s' "$diff_output" | generate_split_plan "$model" "$combined_prompt" "$files_from" "$AI_COMMIT_NARRATE_DIFF"); then
        printf "\r\033[K" >&2
        rm -f "$files_from"
        echo "Error: Failed to generate split plan" >&2
        return 1
    fi
    printf "\r\033[K" >&2
    rm -f "$files_from"

    if [ "$print_message" = true ]; then
        echo "$plan_json"
        return 0
    fi

    if [ "$QUIET" = false ]; then
        print_split_plan "$plan_json"
    fi

    if [ "$dry_run" = true ]; then
        return 0
    fi

    # Re-derive the file list immediately before the first commit. An editor
    # autosave or another process may have changed the working copy since the
    # plan was generated; committing against a stale plan would apply files in
    # an unreviewed state.
    local current_files_list_text
    if [ ${#filesets[@]} -gt 0 ]; then
        current_files_list_text=$(jj "${jj_global_args[@]}" diff --no-pager --summary "${filesets[@]}" | parse_diff_summary)
    else
        current_files_list_text=$(jj "${jj_global_args[@]}" diff --no-pager --summary -r @ | parse_diff_summary)
    fi
    local sorted_files sorted_current
    sorted_files=$(printf '%s\n' "$files_list_text" | sort)
    sorted_current=$(printf '%s\n' "$current_files_list_text" | sort)
    if [ "$sorted_files" != "$sorted_current" ]; then
        echo "Error: Working copy changed since the split plan was generated; aborting to avoid committing unreviewed changes" >&2
        return 1
    fi

    apply_split_plan "$plan_json"
}

# Default values
model=$(select_default_model)
dry_run=false
print_message=false
split=false
custom_prompt=""
AI_COMMIT_NARRATE_DIFF="${AI_COMMIT_NARRATE_DIFF:-never}"
export AI_COMMIT_NARRATE_DIFF
DEBUG=false
QUIET=false
# decorate gates this script's own banners. It is deliberately separate
# from QUIET, which also forwards --quiet to jj and may come to govern
# other behavior; suppressing our headings should not imply either.
decorate=true

# Arrays for organizing arguments
declare -a jj_global_args=()
declare -a filesets=()
declare -a jj_commit_args=()

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -m|--model)
            if [[ $# -lt 2 ]]; then
                echo "Error: --model requires an argument" >&2
                exit 1
            fi
            model="$2"
            shift 2
            ;;
        -n|--dry-run)
            dry_run=true
            shift
            ;;
        --print-message)
            # Emit the message alone, for callers that want to seed an
            # editor or prompt with it. Implies --dry-run and silences the
            # decorative output: nothing is committed.
            print_message=true
            dry_run=true
            decorate=false
            shift
            ;;
        --split)
            split=true
            shift
            ;;
        -l|--list)
            echo "Available models:"
            llm models
            exit 0
            ;;
        -p|--prompt)
            if [[ $# -lt 2 ]]; then
                echo "Error: --prompt requires an argument" >&2
                exit 1
            fi
            custom_prompt="$2"
            shift 2
            ;;
        --narrate-diff)
            if [[ $# -lt 2 ]]; then
                echo "Error: --narrate-diff requires an argument" >&2
                exit 1
            fi
            validate_narration_policy "$2"
            AI_COMMIT_NARRATE_DIFF="$2"
            export AI_COMMIT_NARRATE_DIFF
            shift 2
            ;;
        -i|--interactive)
            jj_commit_args+=("--interactive")
            shift
            ;;
        --tool)
            jj_commit_args+=("--tool" "$2")
            shift 2
            ;;
        --edit)
            jj_commit_args+=("--edit")
            shift
            ;;
        --no-edit)
            jj_commit_args+=("--no-edit")
            shift
            ;;
        --reset-author)
            jj_commit_args+=("--reset-author")
            shift
            ;;
        --author)
            jj_commit_args+=("--author" "$2")
            shift 2
            ;;
        --ignore-immutable)
            jj_global_args+=("--ignore-immutable")
            shift
            ;;
        --debug)
            jj_global_args+=("--debug")
            DEBUG=true
            shift
            ;;
        --color)
            if [[ $# -lt 2 ]]; then
                echo "Error: --color requires an argument" >&2
                exit 1
            fi
            jj_global_args+=("--color" "$2")
            shift 2
            ;;
        --quiet)
            jj_global_args+=("--quiet")
            QUIET=true
            decorate=false
            shift
            ;;
        --no-decoration)
            decorate=false
            shift
            ;;
        --no-pager)
            jj_global_args+=("--no-pager")
            shift
            ;;
        --config)
            if [[ $# -lt 2 ]]; then
                echo "Error: --config requires an argument" >&2
                exit 1
            fi
            jj_global_args+=("--config" "$2")
            shift 2
            ;;
        --config-file)
            if [[ $# -lt 2 ]]; then
                echo "Error: --config-file requires an argument" >&2
                exit 1
            fi
            jj_global_args+=("--config-file" "$2")
            shift 2
            ;;
        -h|--help)
            usage
            ;;
        -*)
            echo "Error: Unknown option: $1" >&2
            usage
            ;;
        *)
            # Positional argument (fileset)
            filesets+=("$1")
            shift
            ;;
    esac
done

# --split groups files by theme; interactive selection contradicts that.
if [ "$split" = true ]; then
    for arg in "${jj_commit_args[@]}"; do
        if [ "$arg" = "--interactive" ] || [ "$arg" = "--tool" ]; then
            echo "Error: --split cannot be used with --interactive or --tool" >&2
            exit 1
        fi
    done
fi

# Check if we're in a jj repository
if ! jj "${jj_global_args[@]}" root >/dev/null 2>&1; then
    echo "Error: Not in a Jujutsu repository" >&2
    exit 1
fi

# Check if there are any changes and show a summary
if [ "$decorate" = true ]; then
    echo -e "\n== Changes to commit =="
fi
if [ ${#filesets[@]} -gt 0 ]; then
    if [ "$decorate" = true ]; then
        echo "Files: ${filesets[*]}"
    fi
    # Check if there are any changes in the specified files
    # Note: Use variable instead of pipe to avoid pipefail interaction with jj exit code
    diff_check=$(jj "${jj_global_args[@]}" diff --no-pager --summary "${filesets[@]}" 2>/dev/null || true)
    if [ -z "$diff_check" ]; then
        if [ "$split" = true ]; then
            echo "Error: No changes to split in specified files" >&2
            exit 1
        fi
        echo "No changes to commit in specified files" >&2
        exit 0
    fi
else
    if [ "$decorate" = true ]; then
        echo "All changes in working copy"
    fi
    # Check if there are any changes in the working copy revision
    # Use -r @ to check changes IN the revision, not uncommitted filesystem changes
    # Note: Use variable instead of pipe to avoid pipefail interaction with jj exit code
    diff_check=$(jj "${jj_global_args[@]}" diff --no-pager --stat -r @ 2>/dev/null || true)
    if [ -z "$diff_check" ]; then
        if [ "$split" = true ]; then
            echo "Error: No changes to split" >&2
            exit 1
        fi
        echo "No changes to commit" >&2
        exit 0
    fi
fi

# Load additional instructions from config files
repo_root=$(jj "${jj_global_args[@]}" root)
additional_instructions=$(load_additional_instructions "$repo_root")

if [ "$DEBUG" = true ]; then
    echo "[DEBUG] Loaded instruction files:" >&2
    if [ -n "$additional_instructions" ]; then
        echo "$additional_instructions" | head -n 3 >&2
        echo "..." >&2
    else
        echo "[DEBUG] No additional instructions found" >&2
    fi
fi

# Combine additional instructions with custom prompt
combined_prompt="$additional_instructions"
if [ -n "$custom_prompt" ]; then
    if [ -n "$combined_prompt" ]; then
        combined_prompt="$combined_prompt

"
    fi
    combined_prompt="$combined_prompt$custom_prompt"
fi

if [ "$split" = true ]; then
    run_split_commit
    exit $?
fi

# Generate commit message with progress indicator
model_display=$(resolve_model_display "$model")

if [ "$DEBUG" = true ]; then
    echo "[DEBUG] Using model: $model_display" >&2
fi

if [ "$decorate" = true ]; then
    echo -e "\n== Generating Commit Message (via ${model_display}) =="
fi
echo -n "Generating commit message... " >&2

# Get the diff and pipe it through the message generator
# Note: jj-ai-commit doesn't have a current_desc, so pass empty string
if [ ${#filesets[@]} -gt 0 ]; then
    diff_output=$(jj "${jj_global_args[@]}" diff --no-pager --git "${filesets[@]}")
else
    diff_output=$(jj "${jj_global_args[@]}" diff --no-pager --git -r @)
fi

if [ "$DEBUG" = true ]; then
    echo "[DEBUG] Prompt:" >&2
    echo "=== Diff ===" >&2
    echo "$diff_output" | head -n 10 >&2
    echo "..." >&2
    echo "=== Instructions ===" >&2
    echo "$combined_prompt" >&2
fi

commit_msg=$(echo "$diff_output" | generate_commit_message "$model" "$combined_prompt" "" "$AI_COMMIT_NARRATE_DIFF") || {
    printf "\r\033[K" >&2
    echo "Error: Failed to generate commit message" >&2
    exit 1
}

printf "\r\033[K" >&2  # Clear progress message

# Display the message
# The message is the result, not decoration: --no-decoration must not
# suppress it. Only --quiet, which asks for silence outright, does.
if [ "$QUIET" = false ]; then
    echo "$commit_msg"
fi

if [ "$print_message" = true ]; then
    exit 0
fi

if [ "$dry_run" = true ]; then
    if [ "$decorate" = true ]; then
        echo -e "\n== Next Steps =="
        if [ ${#filesets[@]} -gt 0 ]; then
            echo "To commit these files with this message, run:"
            echo "  jj commit ${filesets[*]} -m \"...\""
        else
            echo "To commit all changes with this message, run:"
            echo "  jj commit -m \"...\""
        fi
    fi
else
    if [ "$decorate" = true ]; then
        echo -e "\n== Creating commit ==" >&2
    fi

    # Create the commit with the generated message
    # Build command with proper array handling
    commit_cmd=(jj "${jj_global_args[@]}" commit -m "$commit_msg")

    # Add filesets if any
    if [ ${#filesets[@]} -gt 0 ]; then
        commit_cmd+=("${filesets[@]}")
    fi

    # Add additional jj commit arguments if any
    if [ ${#jj_commit_args[@]} -gt 0 ]; then
        commit_cmd+=("${jj_commit_args[@]}")
    fi

    # Execute the commit
    if "${commit_cmd[@]}"; then
        if [ "$decorate" = true ]; then
            echo "Commit created successfully!"

            # Show the new commit
            echo -e "\n== New commit =="
            jj "${jj_global_args[@]}" log --no-pager -r @- -n 1
        fi
    else
        echo "Error: Failed to create commit" >&2
        exit 1
    fi
fi
