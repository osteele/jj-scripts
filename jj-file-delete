#!/bin/bash
set -euo pipefail

# Check for jj installation
if ! command -v jj >/dev/null 2>&1; then
    echo "Error: jj command not found. Install from https://github.com/martinvonz/jj" >&2
    exit 1
fi

usage() {
    cat << EOF
Usage: $(basename "$0") [options] <filepatterns>...

Remove files matching the given patterns from all revisions in a revset.
Supports glob patterns like *.md, src/**/*.py, etc.

Arguments:
    <filepatterns>...       File patterns to remove (supports globs)

Options:
    -r, --revisions REVSET  Revset of revisions to modify (required)
    -n, --dry-run          Show what would be removed without doing it
    -h, --help             Show this help

Examples:
    # Remove specific file from all revisions in pk::
    $(basename "$0") -r "pk::" parallel-differential-coding-slepian-wolf-analysis.md

    # Remove all .md files from revisions
    $(basename "$0") -r "main..@" "*.md"

    # Remove multiple patterns (dry-run)
    $(basename "$0") -n -r "pk::" "*.log" "*.aux" "build/**"

    # Remove files from specific revisions
    $(basename "$0") -r "@- | @" temp.txt
EOF
    exit 1
}

# Default values
revset=""
dry_run=false
declare -a file_patterns=()

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -r|--revisions)
            if [[ $# -lt 2 ]] || [[ "$2" == -* ]]; then
                echo "Error: --revisions requires an argument" >&2
                exit 1
            fi
            revset="$2"
            shift 2
            ;;
        -n|--dry-run)
            dry_run=true
            shift
            ;;
        -h|--help)
            usage
            ;;
        -*)
            echo "Error: Unknown option: $1" >&2
            usage
            ;;
        *)
            # Positional argument (file pattern)
            file_patterns+=("$1")
            shift
            ;;
    esac
done

# Validate arguments
if [ -z "$revset" ]; then
    echo "Error: --revisions is required" >&2
    usage
fi

if [ ${#file_patterns[@]} -eq 0 ]; then
    echo "Error: At least one file pattern is required" >&2
    usage
fi

# Check if we're in a jj repository
if ! jj root >/dev/null 2>&1; then
    echo "Error: Not in a Jujutsu repository" >&2
    exit 1
fi

# Expand revset to individual revisions
revisions=()
while IFS= read -r line; do
    [ -n "$line" ] && revisions+=("$line")
done < <(jj log --no-graph --no-pager -r "$revset" -T 'change_id.short() ++ "\n"')

# Check that we got at least one revision
if [ ${#revisions[@]} -eq 0 ]; then
    echo "Error: No revisions matched the provided revset" >&2
    exit 1
fi

echo "Processing ${#revisions[@]} revision(s)..."

# Function to get files matching patterns in a specific revision
get_matching_files() {
    local revision="$1"
    shift
    local patterns=("$@")

    # Get all files in the revision
    local all_files
    all_files=$(jj file list -r "$revision" 2>/dev/null || true)

    if [ -z "$all_files" ]; then
        return 0
    fi

    # Match files against patterns
    local matched_files=()
    while IFS= read -r file; do
        for pattern in "${patterns[@]}"; do
            # Convert glob pattern to match using bash pattern matching
            if [[ "$file" == $pattern ]]; then
                matched_files+=("$file")
                break
            fi
        done
    done <<< "$all_files"

    # Output matched files (handle empty array with set -u)
    if [ ${#matched_files[@]} -gt 0 ]; then
        for file in "${matched_files[@]}"; do
            echo "$file"
        done
    fi
}

# Save current working copy revision
original_revision=$(jj log -r @ --no-graph --no-pager -T 'change_id.short()')

# Track if any errors occurred
error_occurred=false

# Trap to restore working copy on exit
cleanup() {
    if [ "$error_occurred" = true ]; then
        echo "Error occurred. Restoring working copy..." >&2
        jj edit "$original_revision" >/dev/null 2>&1 || true
    fi
}
trap cleanup EXIT

# Process each revision
total_files_removed=0
revisions_modified=0

for revision in "${revisions[@]}"; do
    # Get files matching patterns in this revision
    matching_files=$(get_matching_files "$revision" "${file_patterns[@]}")

    if [ -z "$matching_files" ]; then
        # No files match in this revision, skip silently
        continue
    fi

    file_count=$(echo "$matching_files" | wc -l | tr -d ' ')

    if [ "$dry_run" = true ]; then
        # Dry-run mode: just show what would be removed
        echo ""
        echo "Revision: $revision"
        while IFS= read -r file; do
            echo "  Would remove: $file"
        done <<< "$matching_files"
        total_files_removed=$((total_files_removed + file_count))
        revisions_modified=$((revisions_modified + 1))
    else
        # Apply mode: actually remove the files
        echo ""
        echo "Revision: $revision"

        # Edit the revision directly
        if ! jj edit "$revision" >/dev/null 2>&1; then
            echo "Error: Failed to edit revision $revision" >&2
            error_occurred=true
            exit 1
        fi

        # Remove matching files
        while IFS= read -r file; do
            if [ -e "$file" ]; then
                rm -f "$file"
                echo "  Removed: $file"
            fi
        done <<< "$matching_files"

        # Explicitly snapshot the changes to ensure they're captured
        # This makes the script robust against user settings for automatic snapshotting
        # Descendant revisions will be automatically updated by Jujutsu when we switch away
        if ! jj describe -m "" >/dev/null 2>&1; then
            echo "Error: Failed to snapshot changes for revision $revision" >&2
            error_occurred=true
            exit 1
        fi

        total_files_removed=$((total_files_removed + file_count))
        revisions_modified=$((revisions_modified + 1))
    fi
done

# Restore original working copy
# Note: We try to edit back to the original revision, but if it was modified,
# we may end up elsewhere. This is expected behavior.
if [ "$dry_run" = false ]; then
    echo ""
    echo "Restoring working copy..."
    # Try to edit to original revision, but don't fail if it's been modified
    jj edit "$original_revision" >/dev/null 2>&1 || true
fi

# Summary
echo ""
echo "=========================================="
if [ "$dry_run" = true ]; then
    echo "Dry-run complete."
    echo "Would remove $total_files_removed file(s) from $revisions_modified revision(s)."
else
    echo "Successfully removed $total_files_removed file(s) from $revisions_modified revision(s)."
fi
